{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals"],
    "paths": {
      "app/*": ["./src/app/*"],
      "environments/*": ["./src/environments/*"],
      "test/*": ["./src/test/*"]
    },
    "strict": false,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/app/modules/editor/model",
    "src/app/modules/editor/scripts",
    "src/environments",
    "src/test",
    "src/typings",
    "src/vite-env.d.ts"
  ],
  "exclude": ["src/app/modules/editor/scripts/paper", "src/typings/paper"]
}
