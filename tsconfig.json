{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals"],
    "paths": {
      "app/*": ["./src/app/*"],
      "environments/*": ["./src/environments/*"],
      "test/*": ["./src/test/*"]
    },
    "strict": true,
    // TODO: turn these on too. model/, scripts/, and store/ already pass them (see
    // tsconfig.strict.json), and there are about 400 errors left in the rest of the app.
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "noImplicitReturns": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"],
  "exclude": [
    "src/app/modules/editor/components/canvas/canvaspaper.directive.ts",
    "src/app/modules/editor/components/toolpanel",
    "src/app/modules/editor/scripts/paper",
    "src/app/modules/editor/services/paper.service.ts",
    "src/typings/paper"
  ]
}
